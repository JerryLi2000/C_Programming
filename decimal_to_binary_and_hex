#include <iostream>
using namespace std;

int main() {
    int f;
    int large = 0;

    cout << "Enter a number: ";
    cin >> f;

    if (f == 0) {
        cout << "The number in binary is 0";
        return 0;
    }

    // Find the largest power of 2 less than or equal to f
    for (int i = 0; (1 << i) <= f; i++) {
        large = i;
    }

    cout << "The number in binary is ";

    // Print each bit from largest to smallest
    for (int i = large; i >= 0; i--) {
        if (f & (1 << i)) {
            cout << 1;
        } else {
            cout << 0;
        }
    }
    
    cout << "\nThe number in hexadecimal is ";
    
    for (int i = large / 4; i >= 0; i--) {
        int num = (f >> (i * 4)) & 0xF;
    
        switch (num) {
            case 10:
                cout << "A";
                break;
            case 11:
                cout << "B";
                break;
            case 12:
                cout << "C";
                break;
            case 13:
                cout << "D";
                break;
            case 14:
                cout << "E";
                break;
            case 15:
                cout << "F";
                break;
            default:
                cout << num;
                break;
        }
    }

    return 0;
}
